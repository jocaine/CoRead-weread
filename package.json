{
  "name": "coread",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "bash -c \"node receiver/index.js & node --env-file-if-exists=data/config/env agent/index.js & wait\"",
    "test": "npm --prefix agent run test:once",
