    "test:ext": "node extension/test/translate-protocol.test.mjs && node extension/test/reader-anchor.test.mjs",
    "backup:chat": "node agent/scripts/backup-chat.mjs",
    "diag:wal": "node agent/scripts/chat.db.diag-wal.mjs"
  }
}
