{
  "name": "coread-agent",
  "type": "module",
  "description": "CoRead 共读 agent — 常驻进程，调用任意 OpenAI 兼容服务商的模型与用户实时讨论标注",
  "main": "index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=../data/config/env index.js",
    "test": "node --test",
    "test:once": "node --test --test-reporter=spec",
    "test:watch": "node --test --watch",
    "smoke": "node --env-file-if-exists=../data/config/env scripts/smoke-topicize.mjs",
    "smoke:stack": "node --env-file-if-exists=../data/config/env scripts/smoke-stack.mjs",
    "backfill:portrait": "node --env-file-if-exists=../data/config/env scripts/backfill-self-portrait.mjs",
    "judge:real": "node --env-file-if-exists=../data/config/env scripts/judge-real.mjs",
    "graph:derive": "node scripts/derive-knowledge-graph.mjs",
    "graph:real": "node --env-file-if-exists=../data/config/env scripts/derive-knowledge-graph.mjs --real",
    "graph:dedupe": "node scripts/dedupe-graph-edges.mjs",
    "extract:real": "node --env-file-if-exists=../data/config/env scripts/extract-real-cases.mjs",
    "group:discussions": "node --env-file-if-exists=../data/config/env scripts/group-discussions.mjs",
    "diag:wal": "node scripts/chat.db.diag-wal.mjs",
    "backup:chat": "node scripts/backup-chat.mjs",
    "smoke:live": "node scripts/smoke-live-flow.mjs",
    "selftest:free": "node scripts/selftest-free-conversations.mjs",
    "check:restore": "node scripts/restore-check.mjs",
    "clean:chat-errors": "node scripts/clean-chat-errors.mjs"
  }
}
