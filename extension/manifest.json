{
  "manifest_version": 3,
  "name": "CoRead - AI共读",
  "version": "0.3.1",
  "description": "微信读书私密标注 + 正文足迹捕获 + 框选/划词翻译 + 自建 PDF 阅读器，配合 CoRead 共读 agent 使用",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "sidePanel", "tabs", "unlimitedStorage", "activeTab", "scripting"],
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "host_permissions": [
    "https://weread.qq.com/*",
    "https://*.weread.qq.com/*",
    "https://www.marxists.org/*",
    "https://www.bilibili.com/*",
    "http://127.0.0.1:7239/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://weread.qq.com/*"],
      "js": ["page_hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["https://weread.qq.com/*"],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": true
    },
    {
      "matches": ["https://www.marxists.org/chinese/*", "https://www.bilibili.com/*"],
      "js": ["source-mia.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CoRead",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "translate-region": {
      "suggested_key": { "default": "Alt+S" },
      "description": "截图翻译（框选屏幕区域）"
    },
    "translate-selection": {
      "suggested_key": { "default": "Alt+T" },
      "description": "翻译选中文字"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["translate-overlay.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
